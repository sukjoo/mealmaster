{
  "entities": {
    "FridgeItem": {
      "title": "FridgeItem",
      "description": "An item stored in the refrigerator",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "icon": { "type": "string" },
        "size": { "type": "string", "enum": ["small", "medium", "large"] },
        "section": { "type": "string", "enum": ["freezer", "fridge"] },
        "shelfIndex": { "type": "integer" },
        "gridX": { "type": "integer" },
        "gridY": { "type": "integer" },
        "uid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "icon", "size", "section", "shelfIndex", "gridX", "gridY", "uid"]
    }
  },
  "firestore": {
    "/items/{itemId}": {
      "schema": "FridgeItem",
      "description": "Collection of refrigerator items"
    }
  }
}
