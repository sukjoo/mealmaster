rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: items
    // Document ID: itemId
    // Fields:
    //   - id: string
    //   - name: string (required, 1-50 chars)
    //   - icon: string (required, lucide icon name)
    //   - size: string (required, small|medium|large)
    //   - section: string (required, freezer|fridge)
    //   - shelfIndex: int (required, 0-5)
    //   - gridX: int (required, 0-10)
    //   - gridY: int (required, 0-10)
    //   - uid: string (required, owner UID)
    //   - createdAt: timestamp (optional)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }
    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    function isValidItem(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 50 &&
             data.icon is string &&
             data.size in ['small', 'medium', 'large'] &&
             data.section in ['freezer', 'fridge'] &&
             data.shelfIndex is int && data.shelfIndex >= 0 &&
             data.gridX is int && data.gridX >= 0 &&
             data.gridY is int && data.gridY >= 0 &&
             data.uid is string;
    }

    match /items/{itemId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && isValidItem(request.resource.data) && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && isDocOwner() && isValidItem(request.resource.data) && uidUnchanged();
      allow delete: if isAuthenticated() && isDocOwner();
    }
  }
}
